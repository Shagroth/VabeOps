generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum Level {
  NOVICE
  STRONG
}

enum LiveSessionType {
  KICKOFF
  MIDPOINT
  FINAL
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(STUDENT)

  accounts    Account[]
  sessions    Session[]
  enrollments Enrollment[]
  submissions Submission[]
  feedback    FeedbackResponse[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime

  modules      Module[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]

  createdAt DateTime @default(now())
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  cohortId String
  level    Level

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
}

model Module {
  id            String  @id @default(cuid())
  cohortId      String
  weekNumber    Int
  title         String
  videoKey      String? // object key in R2, not a full URL
  notesMd       String  @db.Text
  assignmentMd  String  @db.Text
  isOpen        Boolean @default(true) // manual admin toggle, not a date lock

  cohort       Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  feedbackForms FeedbackForm[]

  @@unique([cohortId, weekNumber])
}

model Submission {
  id          String   @id @default(cuid())
  moduleId    String
  userId      String
  content     String   @db.Text
  submittedAt DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
}

model FeedbackForm {
  id        String @id @default(cuid())
  moduleId  String
  level     Level
  questions Json

  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]

  @@unique([moduleId, level])
}

model FeedbackResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  answers     Json
  submittedAt DateTime @default(now())

  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
}

model Application {
  id         String             @id @default(cuid())
  name       String
  email      String
  experience String             @db.Text
  workGoal   String             @db.Text
  status     ApplicationStatus  @default(PENDING)
  createdAt  DateTime           @default(now())
}

model LiveSession {
  id          String          @id @default(cuid())
  cohortId    String
  type        LiveSessionType
  scheduledAt DateTime
  link        String

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
}
