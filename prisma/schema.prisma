generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum Level {
  NOVICE
  STRONG
}

enum LiveSessionType {
  KICKOFF
  MIDPOINT
  FINAL
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  NEEDS_REVISION
  ACCEPTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(STUDENT)

  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  submissions        Submission[]
  feedback           FeedbackResponse[]
  submissionFeedback SubmissionFeedback[]
  moduleComments     ModuleComment[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime

  modules      Module[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]

  createdAt DateTime @default(now())
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  cohortId String
  level    Level

  // Self-written "Поток" profile — what I'm doing/exploring/can help with.
  // No activity rating by design (handoff doc §5.5).
  doingNow    String? @db.Text
  exploring   String? @db.Text
  canHelpWith String? @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
}

model Module {
  id                 String  @id @default(cuid())
  cohortId           String
  weekNumber         Int
  title              String
  videoKey           String? // object key in R2, not a full URL
  notesMd            String  @db.Text
  assignmentMd       String  @db.Text
  isOpen             Boolean @default(true) // manual admin toggle, not a date lock
  conditionsChangedMd String? @db.Text // author-authored "conditions changed" follow-up prompt

  cohort       Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  feedbackForms FeedbackForm[]
  comments     ModuleComment[]

  @@unique([cohortId, weekNumber])
}

// Contextual discussion attached to a week, not a standalone forum feed.
model ModuleComment {
  id        String   @id @default(cuid())
  moduleId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id        String           @id @default(cuid())
  moduleId  String
  userId    String
  status    SubmissionStatus @default(SUBMITTED)
  createdAt DateTime         @default(now())
  // Private to student + instructor by default. True only by the
  // student's explicit opt-in on submit/resubmit — never auto-published.
  publishedToCohort Boolean  @default(false)

  module   Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions SubmissionVersion[]
  feedback SubmissionFeedback[]

  @@unique([moduleId, userId])
}

// One entry per (re)submission — keeps the "Разбор решения" the student
// wrote for that attempt, and the history survives a new version.
model SubmissionVersion {
  id          String   @id @default(cuid())
  submissionId String
  content     String   @db.Text // link to the result / free-form description
  createdAt   DateTime @default(now())

  // "Разбор решения" — handoff doc §5.4 component A
  task               String? @db.Text
  approach           String? @db.Text
  rejectedAlternative String? @db.Text
  verification       String? @db.Text
  riskOrLimit        String? @db.Text
  revisitCondition   String? @db.Text

  // Response to the module's "Изменились условия" prompt, if any
  conditionsResponse String? @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model SubmissionFeedback {
  id           String   @id @default(cuid())
  submissionId String
  authorId     String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model FeedbackForm {
  id        String @id @default(cuid())
  moduleId  String
  level     Level
  questions Json

  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]

  @@unique([moduleId, level])
}

model FeedbackResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  answers     Json
  submittedAt DateTime @default(now())

  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
}

model Application {
  id         String             @id @default(cuid())
  name       String
  email      String
  experience String             @db.Text
  workGoal   String             @db.Text
  status     ApplicationStatus  @default(PENDING)
  createdAt  DateTime           @default(now())
}

model LiveSession {
  id          String          @id @default(cuid())
  cohortId    String
  type        LiveSessionType
  scheduledAt DateTime
  link        String

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
}
