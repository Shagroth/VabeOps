generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ADMIN: full access. EDITOR: editorial review + publish, no cohort ops.
// AUTHOR: owns and edits their own courses/articles/signals/comics.
// MENTOR: cohort feedback/comments, no publication rights. STUDENT: learner.
enum Role {
  STUDENT
  ADMIN
  EDITOR
  AUTHOR
  MENTOR
}

// Shared editorial workflow status for Course/Article/Signal/ComicEpisode.
enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// Only ENGINEERING is ever published publicly today. DESIGN exists so the
// schema doesn't need a migration the day a design track becomes real —
// nothing currently sets or displays it.
enum Track {
  ENGINEERING
  DESIGN
}

enum SignalKind {
  ORIGINAL
  EXTERNAL
}

enum Level {
  NOVICE
  STRONG
}

enum LiveSessionType {
  KICKOFF
  MIDPOINT
  FINAL
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  NEEDS_REVISION
  ACCEPTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(STUDENT)

  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  submissions        Submission[]
  feedback           FeedbackResponse[]
  submissionFeedback SubmissionFeedback[]
  moduleComments     ModuleComment[]

  authorProfile  AuthorProfile?
  courseAuthorOf CourseAuthor[]
  articles       Article[]
  signals        Signal[]
  comicEpisodes  ComicEpisode[]

  createdAt DateTime @default(now())
}

// Public editorial bio, separate from the auth-facing User row. One per
// author User; `isDemo` must stay true (and visibly labeled in the UI)
// until a real author profile replaces it before public launch.
model AuthorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  title       String
  bio         String   @db.Text
  isDemo      Boolean  @default(false)
  avatarGlyph String   @default("AU")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A public course (e.g. the free demo course) managed through Studio.
// Distinct from the cohort's Cohort/Module pair, which has its own
// enrollment-based lifecycle — deliberately not merged into one entity.
model Course {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  dek         String            @db.Text
  track       Track             @default(ENGINEERING)
  status      PublicationStatus @default(DRAFT)
  isFree      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  lessons       Lesson[]
  authors       CourseAuthor[]
  relatedArticles Article[] @relation("CourseArticles")
}

model Lesson {
  id        String @id @default(cuid())
  courseId  String
  order     Int
  title     String
  summary   String @db.Text
  contentMd String @db.Text

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

// Ownership join table — a course can have more than one author.
model CourseAuthor {
  id       String @id @default(cuid())
  courseId String
  userId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model Article {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  dek         String            @db.Text
  bodyMd      String            @db.Text
  category    String
  track       Track             @default(ENGINEERING)
  level       Level?
  readMinutes Int               @default(5)
  status      PublicationStatus @default(DRAFT)
  authorId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  relatedCourses Course[] @relation("CourseArticles")
}

model Signal {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  summary      String            @db.Text
  whyItMatters String            @db.Text
  kind         SignalKind
  sourceUrl    String?
  tags         String[]
  status       PublicationStatus @default(DRAFT)
  authorId     String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  publishedAt  DateTime?

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ComicSeries {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @db.Text

  episodes ComicEpisode[]
}

model ComicEpisode {
  id          String            @id @default(cuid())
  seriesId    String
  slug        String
  order       Int
  title       String
  summary     String            @db.Text
  panels      Json
  status      PublicationStatus @default(DRAFT)
  authorId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  series ComicSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([seriesId, slug])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime

  modules      Module[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]

  createdAt DateTime @default(now())
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  cohortId String
  level    Level

  // Self-written "Поток" profile — what I'm doing/exploring/can help with.
  // No activity rating by design (handoff doc §5.5).
  doingNow    String? @db.Text
  exploring   String? @db.Text
  canHelpWith String? @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
}

model Module {
  id                 String  @id @default(cuid())
  cohortId           String
  weekNumber         Int
  title              String
  videoKey           String? // object key in R2, not a full URL
  notesMd            String  @db.Text
  assignmentMd       String  @db.Text
  isOpen             Boolean @default(true) // manual admin toggle, not a date lock
  conditionsChangedMd String? @db.Text // author-authored "conditions changed" follow-up prompt
  // Which course module (1..5 in src/content/demo-course-program.ts) this
  // week renders. Null = legacy week driven only by notesMd/assignmentMd.
  courseModuleNumber Int?

  cohort       Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  feedbackForms FeedbackForm[]
  comments     ModuleComment[]

  @@unique([cohortId, weekNumber])
}

// Contextual discussion attached to a week, not a standalone forum feed.
model ModuleComment {
  id        String   @id @default(cuid())
  moduleId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id        String           @id @default(cuid())
  moduleId  String
  userId    String
  status    SubmissionStatus @default(SUBMITTED)
  createdAt DateTime         @default(now())
  // Private to student + instructor by default. True only by the
  // student's explicit opt-in on submit/resubmit — never auto-published.
  publishedToCohort Boolean  @default(false)

  module   Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions SubmissionVersion[]
  feedback SubmissionFeedback[]

  @@unique([moduleId, userId])
}

// One entry per (re)submission — keeps the "Разбор решения" the student
// wrote for that attempt, and the history survives a new version.
model SubmissionVersion {
  id          String   @id @default(cuid())
  submissionId String
  content     String   @db.Text // link to the result / free-form description
  createdAt   DateTime @default(now())

  // "Разбор решения" — handoff doc §5.4 component A
  task               String? @db.Text
  approach           String? @db.Text
  rejectedAlternative String? @db.Text
  verification       String? @db.Text
  riskOrLimit        String? @db.Text
  revisitCondition   String? @db.Text

  // Response to the module's "Изменились условия" prompt, if any
  conditionsResponse String? @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model SubmissionFeedback {
  id           String   @id @default(cuid())
  submissionId String
  authorId     String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model FeedbackForm {
  id        String @id @default(cuid())
  moduleId  String
  level     Level
  questions Json

  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]

  @@unique([moduleId, level])
}

model FeedbackResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  answers     Json
  submittedAt DateTime @default(now())

  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
}

model Application {
  id         String            @id @default(cuid())
  name       String
  email      String
  experience String            @db.Text
  workGoal   String            @db.Text
  status     ApplicationStatus @default(PENDING)
  // Explicit consent checkbox on the public form — required at submit time
  // (see apply/actions.ts), stored so there's a record consent was given.
  consent    Boolean           @default(false)
  createdAt  DateTime          @default(now())
}

model LiveSession {
  id          String          @id @default(cuid())
  cohortId    String
  type        LiveSessionType
  scheduledAt DateTime
  link        String

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
}
