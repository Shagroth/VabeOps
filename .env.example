# Copy to .env and fill in real values locally. Never commit the real
# .env file — see .gitignore (`.env*` is already ignored).
#
# None of the values below are real. Do not paste real secrets into
# this file, issues, chat, or anywhere outside your env manager /
# Railway's Variables tab.

# --- Required ---

# Postgres connection string. On Railway this is injected automatically
# by the Postgres plugin — don't set it manually there.
DATABASE_URL="postgresql://user:password@localhost:5432/vabeops"

# Auth.js session/token signing secret. Generate with:
#   npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email sign-in (magic link via Resend) ---
# Required for anyone to be able to sign in. If unset, sign-in requests
# will fail (logged, not silently ignored — this isn't an "optional
# integration", it's the only auth method this app has).

AUTH_RESEND_KEY="re_your_resend_api_key"
EMAIL_FROM="VabeOps <no-reply@yourdomain.com>"

# --- Optional: lesson video storage (Cloudflare R2) ---
# If any of these four are unset, video URLs are skipped (null) instead
# of the app crashing — see src/lib/r2.ts. Only needed once a module
# actually has a video.

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Optional: error monitoring ---
# Not wired up in this codebase yet — see docs/production-readiness.md
# (Phase 6) for why, and what to check before adding it. Left here as a
# placeholder name so a future PR has a single place to document it.

SENTRY_DSN=""

# --- Public (safe to expose to the browser) ---

# Canonical site URL, used for metadata/sitemap/robots. Set to the real
# Railway URL (or custom domain) in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
